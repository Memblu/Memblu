# ─────────────────────────────────────────────────────────────────────────────
# Photop Revival – Backend Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────

# Port the HTTP/WS server listens on (default: 3000)
PORT=3000

# ── Custom Domain (for public dev testing via ngrok, Cloudflare Tunnel, etc.) ─
#
# Set these two variables when you're exposing the server through a tunnel or
# reverse proxy so that the frontend gets the correct WebSocket and media URLs
# instead of guessing from location.host.
#
# PUBLIC_DOMAIN  – the hostname only, NO scheme or trailing slash
#                  e.g.  abc123.ngrok-free.app
#                        my-dev.example.com
# PUBLIC_PROTOCOL – "https" (almost always; use "http" only for plain HTTP tunnels)
#
# Leave both unset (or empty) to run on plain localhost.

PUBLIC_DOMAIN=
PUBLIC_PROTOCOL=https

# ── Captcha ───────────────────────────────────────────────────────────────────

# Set to "true" to skip hCaptcha verification entirely (recommended for dev).
# When true the frontend skips the captcha widget and the backend accepts
# the magic token "dev-bypass" without calling the hCaptcha API.
BYPASS_CAPTCHA=true

# Your hCaptcha secret key (only needed when BYPASS_CAPTCHA is false).
# Get one at https://dashboard.hcaptcha.com/
HCAPTCHA_SECRET_KEY=

# hCaptcha site key shown in the frontend sign-up widget
# (only needed when BYPASS_CAPTCHA is false).
HCAPTCHA_SITE_KEY=1f803f5f-2da5-4f83-b2c6-d9a8e00ba2d3

# ── Storage paths (relative to PhotopBackend/) ────────────────────────────────

# Where SQLite database file is kept (default: data/photop.sqlite)
# DB_PATH=data/photop.sqlite

# Where uploaded images are stored (default: media/)
# MEDIA_PATH=media/

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
